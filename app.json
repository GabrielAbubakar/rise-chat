{
  "expo": {
    "name": "Rise Chat",
    "slug": "rise-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "risechat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ios-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gabrielabubakar.risechat"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FEF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#081C2C",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 128
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/sf-pro-display/SFPRODISPLAYBLACKITALIC.otf",
            "./assets/fonts/sf-pro-display/SFPRODISPLAYBOLD.otf",
            "./assets/fonts/sf-pro-display/SFPRODISPLAYHEAVYITALIC.otf",
            "./assets/fonts/sf-pro-display/SFPRODISPLAYLIGHTITALIC.otf",
            "./assets/fonts/sf-pro-display/SFPRODISPLAYMEDIUM.otf",
            "./assets/fonts/sf-pro-display/SFPRODISPLAYREGULAR.otf",
            "./assets/fonts/sf-pro-display/SFPRODISPLAYSEMIBOLDITALIC.otf",
            "./assets/fonts/sf-pro-display/SFPRODISPLAYTHINITALIC.otf",
            "./assets/fonts/sf-pro-display/SFPRODISPLAYULTRALIGHTITALIC.otf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eaeee8ad-2b73-4dbc-89c3-f0327fc68740"
      }
    }
  }
}
